#!/bin/bash
# Allclean - remove all generated files from a previous run.
cd "$(dirname "$0")"
echo "Cleaning case..."
for dir in [0-9]* [0-9]*.[0-9]*; do
    if [ "$dir" != "0" ] && [ -d "$dir" ]; then rm -rf "$dir"; fi
done
rm -rf constant/polyMesh processor* log.* postProcessing/ mine_cfd_output_*.csv
echo "Done."
