FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// v13 migration additions (compressible fluid solver):
//   rho / rhoFinal  — density update (explicit diagonal solver)
//   h   / hFinal    — enthalpy equation (replaces T as primary energy var)
//
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // ---- Pressure ----
    p_rgh
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0.01;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }

    // ---- Density (explicit update from equation of state) ----
    "(rho|rhoFinal)"
    {
        solver          diagonal;
    }

    // ---- Momentum, enthalpy, turbulence ----
    "(U|h|k|epsilon)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0.1;
    }

    "(U|h|k|epsilon)Final"
    {
        $U;
        relTol          0;
    }

    // ---- Passive scalar species ----
    "(CH4|CO|H2)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0.1;
    }

    "(CH4|CO|H2)Final"
    {
        $(CH4|CO|H2);
        relTol          0;
    }
}

PIMPLE
{
    nOuterCorrectors        2;
    nCorrectors             2;
    nNonOrthogonalCorrectors 1;
    turbOnFinalIterOnly     false;

    // Reference pressure for compressible solver: sets absolute level.
    // Outlet fixedValue (101325 Pa) also pins pressure, so this is
    // a belt-and-suspenders reference for closed-domain protection.
    pRef                    101325;
}

relaxationFactors
{
    fields
    {
        p_rgh       0.7;
        rho         1.0;    // density updated explicitly — no relaxation needed
    }
    equations
    {
        U           0.7;
        h           0.7;
        k           0.7;
        epsilon     0.7;
        CH4         0.9;
        CO          0.9;
        H2          0.9;
    }
}

