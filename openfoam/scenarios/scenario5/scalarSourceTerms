// Scenario 5 — Emergency Gas Release / Blowout (2.0 m/s ventilation)
//
// Sources: Catastrophic outburst from both chambers and the South Stub.
// Represents a sudden coal or gas outburst event — pressurised gas pocket
// ruptures simultaneously at three locations. Even at full ventilation
// (2.0 m/s) the emission rate far exceeds dilution capacity.
//
// Physical basis:
//   Target Q_CH4 = 10 L/min = 1.67e-4 m3/s per source
//   Su ≈ 1.67e-4 / 0.06 ≈ 2.8e-3  [vol_frac / s]
//
//   Gas composition: CH4/H2 dominant (outburst from dry coal seam),
//   CO elevated from pressure-driven oxidation during ejection.
//
// Expected behaviour:
//   Near-total DANGER within 60 s despite full ventilation.
//   CH4 exceeds LEL (5%) in both chambers by t=120 s.
//   H2 rises to ceiling in both dead ends (buoyancy-driven stratification).
//   South Stub fills completely (recirculation, no through-flow).

blowout_S5_chamber1
{
    type            scalarSemiImplicitSource;
    active          yes;
    selectionMode   points;
    points          ((25 13 1.5));  // Chamber 1 dead end

    volumeMode      specific;

    injectionRateSuSp
    {
        CH4     (2.8e-3  0);        // 10 L/min
        CO      (7.0e-4  0);        // 2.5 L/min
        H2      (1.1e-3  0);        // 3.8 L/min
    }
}

